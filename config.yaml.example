# Temperature and Window Notification Configuration Example
# This app monitors temperature and window/door sensors, sending notifications
# when conditions require user action (e.g., open window when too hot)
open_window_notification:
  module: i1_open_window
  class: TemperatureWindowNotification

  # List of people to notify - at least one person required
  persons:
    - name: Lars                        # Human-readable name (optional)
      notify: mobile_app_iphone_28      # Notification service (required)
      tracker: device_tracker.iphone_28 # Device tracker for presence detection (optional)

  # Temperature sensor configuration
  temperature:
    sensor: sensor.bedroom_temperature  # Temperature sensor entity ID
    below: 16                          # Temperature threshold for "too cold" (°C)
    above: 20                          # Temperature threshold for "too warm" (°C)

  # Window/door sensor configuration
  window:
    sensor: binary_sensor.bedroom_window  # Binary sensor entity ID
    below: "off"                           # Expected state when temp < below_threshold
    above: "on"                          # Expected state when temp >= above_threshold

  # Notification message configuration
  messages:
    below: "Close bedroom window"        # Message when temp too low
    above: "Open bedroom window"         # Message when temp too high
    title: "Bedroom temp"                # Notification title
    cooldown: 1800                      # Cooldown period in seconds (30 minutes)

  # Time window configuration (24-hour format)
  when:
    after: 15   # Start monitoring at 15:00 (3 PM)
    before: 22  # Stop monitoring at 22:00 (10 PM)

  # Weather integration (optional) - suppresses open window notifications if rain is forecasted
  nowcast_sensor: weather.met_no_nowcast_met_nowcast  # MET.no nowcast precipitation sensor

  # ── Android delivery: which channel these alerts arrive on (T-52) ────
  #
  # The companion app's default notification channel can be switched off on the
  # phone, and when it is, Home Assistant still reports every notification as
  # sent while Android discards it. That failure is completely silent at both
  # ends -- it was found by experiment, not from a log. Naming a dedicated
  # channel keeps these alerts independent of that setting, and lets them be
  # muted on their own without silencing every other app.
  #
  # `priority: high` plus `ttl: 0` stops Doze deferring them. Reserve high for
  # alerts that genuinely warrant waking the device; for informational ones the
  # right answer is not normal priority (which is what silently fails today) but
  # not sending, or a digest.
  #
  # Both are optional. Shown here with the defaults the code applies.
  # notification_channel: temperature_alerts
  # notification_priority: high

  # ── Policy D2: quiet hours and persisted cooldowns ────────────────────
  #
  # Before S5-08b this app had neither. With a 30-minute `cooldown`, a window
  # left open on a cold night re-notified every half hour until dawn. And the
  # cooldown dict lived in memory, so every AppDaemon restart cleared it --
  # including any "Ignore today", which promised silence until tomorrow and
  # delivered silence until the next restart.
  #
  # A FIRST notification is always sent, whatever the hour: an open window on a
  # cold night is news. Only repeats are held, and holding does not extend the
  # window, so a held alert lands when quiet hours end rather than a full
  # cooldown later.
  quiet_hours: true
  quiet_start: 22            # hour 0-23, inclusive
  quiet_end: 7               # hour 0-23, exclusive

  # Where the cooldowns and any "Ignore today" are kept. Outside the app
  # directory so a redeploy does not wipe them.
  state_file: /conf/open_window_open_window.json
